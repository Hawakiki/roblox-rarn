{
  "name": "rarn",
  "version": "0.0.0",
  "private": true,
  "description": "A package manager for Roblox that speaks the Wally registry",
  "license": "MIT",
  "type": "module",
  "bin": {
    "rarn": "./src/cli.ts"
  },
  "scripts": {
    "rarn": "bun run src/cli.ts",
    "typecheck": "tsc --noEmit",
    "format": "biome check src tests",
    "format:fix": "biome check --write src tests",
    "lint": "eslint src tests --max-warnings=0",
    "lint:fix": "eslint src tests --fix",
    "check": "bun run format && bun run lint && bun run typecheck && bun test",
    "lint-staged": "lint-staged",
    "test": "bun test",
    "build": "bun build --compile --minify --bytecode src/cli.ts --outfile dist/rarn",
    "build:windows": "bun build --compile --minify --bytecode --target=bun-windows-x64 src/cli.ts --outfile dist/rarn-windows-x64.exe",
    "build:macos-arm64": "bun build --compile --minify --bytecode --target=bun-darwin-arm64 src/cli.ts --outfile dist/rarn-macos-arm64",
    "build:linux-x64": "bun build --compile --minify --bytecode --target=bun-linux-x64 src/cli.ts --outfile dist/rarn-linux-x64",
    "prepare": "husky"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "fflate": "^0.8.2",
    "ora": "^8.2.0",
    "semver": "^7.7.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@eslint/js": "^10.0.1",
    "@types/bun": "latest",
    "@types/semver": "^7.5.8",
    "eslint": "^10.8.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.67.0"
  },
  "trustedDependencies": ["@biomejs/biome"]
}
