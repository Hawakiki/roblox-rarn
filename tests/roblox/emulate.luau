--!strict
--[[
	A minimal stand-in for Roblox's module system, enough to check a Rarn install.

	Two things about Roblox `require` decide whether an install tree is correct, and
	both are reproduced here exactly:

	  1. It takes an **Instance**, not a path. Resolution is tree navigation, so the
	     shape of the tree is the whole contract.
	  2. It caches **per ModuleScript instance**. Two instances holding identical
	     source are two modules with two separate states — which is why a duplicated
	     package silently breaks any singleton inside it.

	What this cannot tell you is whether the code runs in Roblox: there is no engine
	here, no services, no replication. It answers "does this tree resolve, and does
	deduplication actually deduplicate" — which is what a linker can get wrong.
]]

local fs = require("@lune/fs")
local luau = require("@lune/luau")

export type Node = {
	Name: string,
	ClassName: string,
	Parent: Node?,
	Source: string?,
	Children: { [string]: Node },
}

local Emulator = {}

--[[
	Builds a node tree from a directory, following Rojo's file mapping.

	  X.luau / X.lua          -> ModuleScript "X"
	  X/ containing init.luau -> ModuleScript "X", other entries become its children
	  X/ otherwise            -> Folder "X"

	The `init` rule is the one that matters here: a pruned package directory is only
	a ModuleScript because it contains `init.lua`, and that is exactly what makes
	`require(_Index[entry].promise)` land on a module rather than on a folder.
]]
local function build(path: string, name: string, parent: Node?): Node?
	local metadata = fs.metadata(path)
	if not metadata.exists then
		return nil
	end

	if metadata.kind == "file" then
		local stem = name:match("^(.*)%.lua[u]?$")
		if stem == nil then
			return nil
		end
		return {
			Name = stem,
			ClassName = "ModuleScript",
			Parent = parent,
			Source = fs.readFile(path),
			Children = {},
		}
	end

	local node: Node = {
		Name = name,
		ClassName = "Folder",
		Parent = parent,
		Source = nil,
		Children = {},
	}

	for _, entry in fs.readDir(path) do
		if entry:match("^init%.lua[u]?$") ~= nil then
			node.ClassName = "ModuleScript"
			node.Source = fs.readFile(path .. "/" .. entry)
		else
			local child = build(path .. "/" .. entry, entry, node)
			if child ~= nil then
				node.Children[child.Name] = child
			end
		end
	end

	return node
end

function Emulator.tree(path: string, name: string): Node
	local root = build(path, name, nil)
	assert(root ~= nil, `nothing to load at {path}`)
	return root
end

export type Runtime = {
	root: any,
	require: (any) -> any,
	loads: () -> number,
}

export type Options = {
	-- Extra globals merged into every module environment.
	globals: { [string]: any }?,
	--[[
		Whether to run package code, as opposed to only the shims Rarn generated.

		Off by default, and that is the important setting. A real package calls into
		the engine at module scope — `game:GetService`, `task.defer`, `RunService`
		events — so executing one here measures how complete the stubs are, not
		whether the install tree is correct. With it off, a package module resolves to
		a sentinel that is unique per instance, which is exactly what the questions
		worth asking need:

		  - does this shim reach a real ModuleScript?
		  - do two shims for one package reach the *same* instance?

		Whether the package's own code then runs is Roblox's business, not the
		linker's.
	]]
	execute: boolean?,
}

-- Marker Rarn writes into every file it generates.
local SHIM_MARKER = "Generated by Rarn"

--[[
	Whether a module is a generated link rather than package code.

	Recognised two ways. Rarn's own marker is the reliable one, but a link is also
	just a lone `return require(...)`, and matching that shape too lets this harness
	run against a Wally install as well — which is the only way to compare the two
	honestly. Trusting the marker alone quietly reclassified every Wally link as
	package code and stubbed it out, turning failures into passes.
]]
function Emulator.isShim(node: Node): boolean
	local source = node.Source
	if source == nil then
		return false
	end
	if string.find(source, SHIM_MARKER, 1, true) ~= nil then
		return true
	end

	local body = string.gsub(source, "%-%-[^\n]*", "")
	body = string.gsub(body, "%s+", " ")
	body = string.gsub(body, "^ ", "")
	body = string.gsub(body, " $", "")
	return string.match(body, "^return require%b()$") ~= nil
end

--[[
	Creates a runtime over a node tree.
]]
function Emulator.runtime(root: Node, options: Options?): Runtime
	local globals = (options and options.globals) or {}
	local execute = (options and options.execute) == true

	-- One proxy per node, both directions. Stable identity is the entire point:
	-- `a == b` must mean "the same instance", because that is what Roblox keys its
	-- module cache on.
	local proxyOf: { [Node]: any } = {}
	local nodeOf: { [any]: Node } = {}

	local function wrap(node: Node): any
		local existing = proxyOf[node]
		if existing ~= nil then
			return existing
		end

		local proxy = setmetatable({}, {
			__index = function(_, key: string): any
				if key == "Name" then
					return node.Name
				elseif key == "ClassName" then
					return node.ClassName
				elseif key == "Parent" then
					return if node.Parent ~= nil then wrap(node.Parent) else nil
				end
				local child = node.Children[key]
				return if child ~= nil then wrap(child) else nil
			end,
			__tostring = function()
				return node.Name
			end,
		})

		proxyOf[node] = proxy
		nodeOf[proxy] = node
		return proxy
	end

	local cache: { [any]: any } = {}
	local loading: { [any]: boolean } = {}
	local loads = 0

	local function requireFn(target: any): any
		assert(target ~= nil, "require() was given nil — the tree has no such path")

		local node = nodeOf[target]
		assert(node ~= nil, "require() was given something that is not an instance")
		assert(
			node.ClassName == "ModuleScript",
			`require() expects a ModuleScript, got {node.ClassName} named {node.Name}`
		)

		-- Keyed by the proxy, which is one-to-one with the node. This single lookup
		-- is the behaviour the dedupe assertion is really testing.
		local cached = cache[target]
		if cached ~= nil then
			return cached
		end

		-- Package code stays unevaluated unless asked for. The sentinel is still
		-- cached per instance, so identity comparisons mean exactly what they would
		-- if the package had run.
		if not execute and not Emulator.isShim(node) then
			local sentinel = { __package = node.Name }
			cache[target] = sentinel
			return sentinel
		end

		assert(not loading[target], `cyclic require of {node.Name}`)
		loading[target] = true

		local environment: { [string]: any } = { script = target, require = requireFn }
		for key, value in globals do
			environment[key] = value
		end

		local chunk = luau.load(node.Source :: string, {
			environment = environment,
			injectGlobals = true,
		})

		loads += 1
		local result = chunk()
		loading[target] = nil
		cache[target] = result
		return result
	end

	return {
		root = wrap(root),
		require = requireFn,
		loads = function()
			return loads
		end,
	}
end

return Emulator
