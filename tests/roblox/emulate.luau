--!strict
--[[
	A minimal stand-in for Roblox's module system, enough to check a Rarn install.

	Two things about Roblox `require` decide whether an install tree is correct, and
	both are reproduced here exactly:

	  1. It takes an **Instance**, not a path. Resolution is tree navigation, so the
	     shape of the tree is the whole contract.
	  2. It caches **per ModuleScript instance**. Two instances holding identical
	     source are two modules with two separate states — which is why a duplicated
	     package silently breaks any singleton inside it.

	What this cannot tell you is whether the code runs in Roblox: there is no engine
	here, no services, no replication. It answers "does this tree resolve, and does
	deduplication actually deduplicate" — which is what a linker can get wrong.
]]

local fs = require("@lune/fs")
local luau = require("@lune/luau")

export type Node = {
	Name: string,
	ClassName: string,
	Parent: Node?,
	Source: string?,
	Children: { [string]: Node },
}

local Emulator = {}

--[[
	Builds a node tree from a directory, following Rojo's file mapping.

	  X.luau / X.lua          -> ModuleScript "X"
	  X/ containing init.luau -> ModuleScript "X", other entries become its children
	  X/ otherwise            -> Folder "X"

	The `init` rule is the one that matters here: a pruned package directory is only
	a ModuleScript because it contains `init.lua`, and that is exactly what makes
	`require(_Index[entry].promise)` land on a module rather than on a folder.
]]
local function build(path: string, name: string, parent: Node?): Node?
	local metadata = fs.metadata(path)
	if not metadata.exists then
		return nil
	end

	if metadata.kind == "file" then
		local stem = name:match("^(.*)%.lua[u]?$")
		if stem == nil then
			return nil
		end
		return {
			Name = stem,
			ClassName = "ModuleScript",
			Parent = parent,
			Source = fs.readFile(path),
			Children = {},
		}
	end

	local node: Node = {
		Name = name,
		ClassName = "Folder",
		Parent = parent,
		Source = nil,
		Children = {},
	}

	for _, entry in fs.readDir(path) do
		if entry:match("^init%.lua[u]?$") ~= nil then
			node.ClassName = "ModuleScript"
			node.Source = fs.readFile(path .. "/" .. entry)
		else
			local child = build(path .. "/" .. entry, entry, node)
			if child ~= nil then
				node.Children[child.Name] = child
			end
		end
	end

	return node
end

function Emulator.tree(path: string, name: string): Node
	local root = build(path, name, nil)
	assert(root ~= nil, `nothing to load at {path}`)
	return root
end

export type Runtime = {
	root: any,
	require: (any) -> any,
	loads: () -> number,
}

export type Options = {
	-- Extra globals merged into every module environment.
	globals: { [string]: any }?,
	--[[
		Whether to run package code, as opposed to only the shims Rarn generated.

		Off by default, and that is the important setting. A real package calls into
		the engine at module scope — `game:GetService`, `task.defer`, `RunService`
		events — so executing one here measures how complete the stubs are, not
		whether the install tree is correct. With it off, a package module resolves to
		a sentinel that is unique per instance, which is exactly what the questions
		worth asking need:

		  - does this shim reach a real ModuleScript?
		  - do two shims for one package reach the *same* instance?

		Whether the package's own code then runs is Roblox's business, not the
		linker's.
	]]
	execute: boolean?,
	--[[
		Other realm trees, keyed by the DataModel path they are mounted at.

		    { ["game.ReplicatedStorage.RARN_MODULE"] = sharedRealmNode }

		A cross-realm shim cannot walk relatively — the realms sync to different
		services — so it names an absolute path instead:

		    return require(game.ReplicatedStorage.RARN_MODULE._Index["…"]["promise"])

		Without a mount, `game.ReplicatedStorage` is a bare stub, `.RARN_MODULE` is
		nil, and the require fails. That failure looks identical to a broken install
		while the install is in fact correct — so the harness reported the one shim
		form it exists to check as broken, and had no way to check it at all.

		Mounted nodes go through the same `wrap`, so a package reached across a realm
		boundary compares equal to the same package reached within one. That identity
		is the whole question, and it only becomes askable here.
	]]
	mounts: { [string]: Node }?,
}

-- Marker Rarn writes into every file it generates.
local SHIM_MARKER = "Generated by Rarn"

--[[
	Whether a module is a generated link rather than package code.

	Recognised two ways. Rarn's own marker is the reliable one, but a link is also
	just a lone `return require(...)`, and matching that shape too lets this harness
	run against a Wally install as well — which is the only way to compare the two
	honestly. Trusting the marker alone quietly reclassified every Wally link as
	package code and stubbed it out, turning failures into passes.
]]
function Emulator.isShim(node: Node): boolean
	local source = node.Source
	if source == nil then
		return false
	end
	if string.find(source, SHIM_MARKER, 1, true) ~= nil then
		return true
	end

	local body = string.gsub(source, "%-%-[^\n]*", "")
	body = string.gsub(body, "%s+", " ")
	body = string.gsub(body, "^ ", "")
	body = string.gsub(body, " $", "")
	return string.match(body, "^return require%b()$") ~= nil
end

--[[
	Creates a runtime over a node tree.
]]
function Emulator.runtime(root: Node, options: Options?): Runtime
	local globals = (options and options.globals) or {}
	local execute = (options and options.execute) == true

	-- One proxy per node, both directions. Stable identity is the entire point:
	-- `a == b` must mean "the same instance", because that is what Roblox keys its
	-- module cache on.
	local proxyOf: { [Node]: any } = {}
	local nodeOf: { [any]: Node } = {}

	local wrap: (Node) -> any

	--[[
		The read-only tree queries, which are not engine behaviour whatever the names
		suggest: every one is a pure function of the tree already built above, and
		`:WaitForChild("x")` is `["x"]` with a different spelling.

		They are here because real package code reaches for them constantly — 6171
		calls across the 584 packages in a warm cache, `:WaitForChild` alone 3256 —
		and without them `--execute` could not load the JS-port half of the registry
		at all. Measured on two real install trees, adding them takes package loads
		from 5/38 to 17/38.

		**Nothing that changes the tree is here.** `:Destroy` and `:Clone` are common
		too (876 and 132), and both are refused on purpose: a tree that package code
		can mutate would put the identity guarantee this harness exists to check at
		the mercy of the thing being checked.
	]]
	local queries: { [string]: (Node, ...any) -> any }

	--[[
		Enough of the class hierarchy to answer `:IsA` honestly.

		Short because it is complete for what `Emulator.tree` can produce: a node is a
		ModuleScript or a Folder and there is no third case. Inventing the rest of the
		hierarchy would be modelling classes this harness can never hold.
	]]
	local CLASS_PARENT: { [string]: string } = {
		ModuleScript = "LuaSourceContainer",
		LuaSourceContainer = "Instance",
		Folder = "Instance",
	}

	local function descend(node: Node, into: { Node })
		for _, child in queries.GetChildren(node) do
			table.insert(into, nodeOf[child])
			descend(nodeOf[child], into)
		end
	end

	queries = {
		FindFirstChild = function(node: Node, name: string, recursive: boolean?): any
			local child = node.Children[name]
			if child ~= nil then
				return wrap(child)
			end
			if recursive ~= true then
				return nil
			end
			for _, descendant in queries.GetDescendants(node) do
				if descendant.Name == name then
					return descendant
				end
			end
			return nil
		end,

		--[[
			The tree is static, so there is nothing to wait for: a child that is absent
			now is absent for the whole run. Roblox would yield and then warn; returning
			the same answer `FindFirstChild` gives is the honest translation, and a
			harness that blocked would only ever hang.
		]]
		WaitForChild = function(node: Node, name: string): any
			return queries.FindFirstChild(node, name)
		end,

		FindFirstChildOfClass = function(node: Node, className: string): any
			for _, child in queries.GetChildren(node) do
				if child.ClassName == className then
					return child
				end
			end
			return nil
		end,

		FindFirstAncestor = function(node: Node, name: string): any
			local current = node.Parent
			while current ~= nil do
				if current.Name == name then
					return wrap(current)
				end
				current = current.Parent
			end
			return nil
		end,

		--[[
			Sorted by name, which Roblox does not do.

			Roblox returns children in the order they were added, and a tree read off a
			filesystem has no such order to recover — `fs.readDir` decides it. Sorting is
			the one choice that makes a run repeatable, and a harness whose result
			depends on directory iteration order would be worse than one that is
			knowingly ordered differently from the engine.
		]]
		GetChildren = function(node: Node): { any }
			local names = {}
			for name in node.Children do
				table.insert(names, name)
			end
			table.sort(names)

			local out = {}
			for _, name in names do
				table.insert(out, wrap(node.Children[name]))
			end
			return out
		end,

		GetDescendants = function(node: Node): { any }
			local nodes: { Node } = {}
			descend(node, nodes)

			local out = {}
			for _, found in nodes do
				table.insert(out, wrap(found))
			end
			return out
		end,

		IsA = function(node: Node, className: string): boolean
			local current: string? = node.ClassName
			while current ~= nil do
				if current == className then
					return true
				end
				current = CLASS_PARENT[current]
			end
			return false
		end,

		IsDescendantOf = function(node: Node, other: any): boolean
			local target = nodeOf[other]
			if target == nil then
				return false
			end
			local current = node.Parent
			while current ~= nil do
				if current == target then
					return true
				end
				current = current.Parent
			end
			return false
		end,

		IsAncestorOf = function(node: Node, other: any): boolean
			local target = nodeOf[other]
			return if target == nil then false else queries.IsDescendantOf(target, wrap(node))
		end,

		--[[
			Starts at whatever tree was loaded, not at `game`.

			Roblox's version names the path from the DataModel root, and this harness is
			handed one realm directory. The difference is real and is left as it is: the
			alternative is inventing service names that were never loaded.
		]]
		GetFullName = function(node: Node): string
			local parts = { node.Name }
			local current = node.Parent
			while current ~= nil do
				table.insert(parts, 1, current.Name)
				current = current.Parent
			end
			return table.concat(parts, ".")
		end,
	}

	wrap = function(node: Node): any
		local existing = proxyOf[node]
		if existing ~= nil then
			return existing
		end

		local proxy = setmetatable({}, {
			__index = function(_, key: string): any
				if key == "Name" then
					return node.Name
				elseif key == "ClassName" then
					return node.ClassName
				elseif key == "Parent" then
					return if node.Parent ~= nil then wrap(node.Parent) else nil
				end

				-- Members before children, as Roblox resolves them: an instance with a
				-- child called `GetChildren` still answers the method there.
				local query = queries[key]
				if query ~= nil then
					return function(_self: any, ...): any
						return query(node, ...)
					end
				end

				local child = node.Children[key]
				return if child ~= nil then wrap(child) else nil
			end,
			__tostring = function()
				return node.Name
			end,
		})

		proxyOf[node] = proxy
		nodeOf[proxy] = node
		return proxy
	end

	--[[
		The `game` a shim sees.

		Built here rather than handed in as a global because proxy identity belongs to
		this runtime: a mounted realm has to go through the same `wrap` as the primary
		one, or a package reached across realms would compare unequal to itself and the
		dedupe assertion would be answering a different question than it appears to.

		Unmounted paths keep returning a permissive stub. Package code under
		`--execute` calls `game:GetService` and similar at module scope, and making
		that a hard error would trade one false failure for another.
	]]
	local mounts = (options and options.mounts) or {}

	local function stubFor(prefix: string): any
		return setmetatable({ Name = string.match(prefix, "[^.]+$") or prefix }, {
			__index = function(_, key: string): any
				local path = `{prefix}.{key}`
				local mounted = mounts[path]
				if mounted ~= nil then
					return wrap(mounted)
				end
				return stubFor(path)
			end,
			--[[
				A stub is callable, so `game:GetService("RunService")` yields another stub
				instead of an error.

				This is what the paragraph above always claimed and the code did not do:
				every key returned a table, and calling one failed with `attempt to call a
				table value`. Measured across two real install trees, that was 7 of 33
				failed package loads under `--execute` — a hard error in the exact place a
				permissive stub was supposed to prevent one.

				It buys reach, not fidelity. A package whose module scope only *touches*
				the engine now gets past it; one that depends on the engine answering
				truthfully is still not being tested, and `--execute` still cannot say
				whether anything works in Roblox.
			]]
			__call = function(_, ...): any
				return stubFor(`{prefix}()`)
			end,
			__tostring = function()
				return prefix
			end,
		})
	end

	local gameStub = stubFor("game")

	local cache: { [any]: any } = {}
	local loading: { [any]: boolean } = {}
	local loads = 0

	local function requireFn(target: any): any
		assert(target ~= nil, "require() was given nil — the tree has no such path")

		local node = nodeOf[target]
		assert(node ~= nil, "require() was given something that is not an instance")
		assert(
			node.ClassName == "ModuleScript",
			`require() expects a ModuleScript, got {node.ClassName} named {node.Name}`
		)

		-- Keyed by the proxy, which is one-to-one with the node. This single lookup
		-- is the behaviour the dedupe assertion is really testing.
		local cached = cache[target]
		if cached ~= nil then
			return cached
		end

		-- Package code stays unevaluated unless asked for. The sentinel is still
		-- cached per instance, so identity comparisons mean exactly what they would
		-- if the package had run.
		if not execute and not Emulator.isShim(node) then
			local sentinel = { __package = node.Name }
			cache[target] = sentinel
			return sentinel
		end

		assert(not loading[target], `cyclic require of {node.Name}`)
		loading[target] = true

		-- `game` is supplied here, before the caller's globals, so a caller may still
		-- override it — but no longer has to invent one to make a shim resolve.
		local environment: { [string]: any } = { script = target, require = requireFn, game = gameStub }
		for key, value in globals do
			environment[key] = value
		end

		local chunk = luau.load(node.Source :: string, {
			environment = environment,
			injectGlobals = true,
		})

		loads += 1

		--[[
			The flag is cleared whether the module returned or threw.

			Clearing it only on success left a failed module marked as still loading
			forever, so every later require of it reported `cyclic require` — a cause
			that was not there, in place of the one that was. Reproduced in two lines:
			a module that errors once answers "cyclic require" the second time.

			It bites hardest where it is least visible. `verify.luau` pcalls each shim
			and carries on, so the first real failure in a run rewrites the diagnosis of
			everything downstream of it.
		]]
		local completed, result = pcall(chunk)
		loading[target] = nil
		if not completed then
			error(result, 0)
		end

		cache[target] = result
		return result
	end

	return {
		root = wrap(root),
		require = requireFn,
		loads = function()
			return loads
		end,
	}
end

return Emulator
